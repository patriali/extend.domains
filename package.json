{
  "name": "extend-domains",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint:ext": "web-ext lint --source-dir dist/firefox",
    "package:chrome": "node scripts/package.mjs chrome",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir web-ext-artifacts --overwrite-dest",
    "package:source": "git archive --format=zip --prefix=extend-domains/ -o web-ext-artifacts/extend-domains-source.zip HEAD",
    "release": "npm run typecheck && npm test && npm run build && npm run lint:ext && npm run package:chrome && npm run package:firefox && npm run package:source",
    "test": "node --test 'src/**/*.test.ts'",
    "update-psl": "node scripts/update-psl.mjs",
    "update-wordlist": "node scripts/update-wordlist.mjs",
    "update-rdap-coverage": "node scripts/update-rdap-coverage.mjs"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/webextension-polyfill": "^0.12.3",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "web-ext": "^10.5.0"
  }
}
